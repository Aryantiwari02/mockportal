# ============================================================
# YojanaSaathi Backend — Environment Variables Template
# ============================================================
# Copy this file to backend/.env and fill in your actual values.
# NEVER commit your actual backend/.env file to Git.

# ------------------------------------
# Django Core
# ------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,api.yojanasaathi.gov.in,portal.yojanasaathi.gov.in
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://portal.yojanasaathi.gov.in
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://portal.yojanasaathi.gov.in

# ------------------------------------
# YojanaSaathi AI Agent Key (M2M)
# ------------------------------------
# Generate using: python manage.py manage_agent_keys create --name "Production Agent"
YOJANASAATHI_AGENT_API_KEY=yjs_ag_replace_with_cryptographically_strong_random_key

# ------------------------------------
# HTTPS & Production Security
# ------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=31536000

# ------------------------------------
# Optional Production Database (PostgreSQL)
# ------------------------------------
# DATABASE_URL=postgres://user:password@db-host:5432/yojana_db

# ------------------------------------
# Twilio OTP (required for SMS OTP login)
# ------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ALLOWED_MOBILE=9876543210,9123456789
# OTP_MODE: "twilio" sends real SMS; "demo" skips Twilio and accepts OTP_DEMO_CODE.
OTP_MODE=twilio
OTP_DEMO_CODE=123456
