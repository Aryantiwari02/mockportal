# ============================================================
# YojanaSaathi Frontend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to Git.

# ------------------------------------
# API Base URL
# ------------------------------------
# Leave empty (or omit) to use the Vite dev proxy (/api → Django backend).
# Set to the full public URL when the frontend and backend are on different
# origins, e.g. when running behind a public tunnel:
#
#   VITE_API_BASE_URL=https://your-public-tunnel-domain.example.com/api
#
VITE_API_BASE_URL=

# ------------------------------------
# Backend URL (for the Vite dev proxy)
# ------------------------------------
# Used only during local development.
# Default: http://127.0.0.1:8000
#
# VITE_BACKEND_URL=http://127.0.0.1:8000
