# YojanaSaathi API base URL
YOJANASAATHI_API_BASE=https://yojanasaathi-backend-b8ih.onrender.com

# Agent key — server-side ONLY. Never expose to the browser.
# Get the current value from the project owner.
YOJANASAATHI_AGENT_API_KEY=yjs_ag_replace_me

# Origin of the website that will call this proxy
ALLOWED_ORIGIN=https://your-other-website.example.com

# Port this proxy listens on
PORT=8080
